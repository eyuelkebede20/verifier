{
  "name": "senay-verifier-api",
  "version": "3.1.0",
  "description": "Standalone Ethiopian bank receipt verification microservice",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "test": "tsc && node --test dist/tests/*.test.js",
    "pack:cpanel": "node scripts/pack-cpanel.mjs"
  },
  "keywords": [
    "telebirr",
    "cbe",
    "dashen",
    "abyssinia",
    "mpesa",
    "cbebirr",
    "ethiopia-payments",
    "receipt-verifier"
  ],
  "author": "Senay Creatives",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "npm:puppeteer-core@^24.8.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.17",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
