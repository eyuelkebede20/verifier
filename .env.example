# ==============================================================================
# Senay Verifier API Configuration
# Microservice for: Telebirr, CBE, Dashen, BoA, CBE Birr, M-Pesa
# Deployment URL: https://verifier.senaycreatives.com
# ==============================================================================

PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Developer / Admin Access (/admin)
# Single master secret to unlock the developer console, generate app keys & view usage.
# Set either a plaintext master key:
ADMIN_KEY=senay_admin_master_secret_2026_change_me
# OR a pre-computed SHA-256 hash (hex) for extra security:
# ADMIN_KEY_HASH=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# ------------------------------------------------------------------------------
# Headless Open-Source API Manager (Unkey - https://unkey.com / self-hosted)
# If provided, API key provisioning, rate limits, and analytics offload to Unkey!
# UNKEY_ROOT_KEY=unkey_mAstEr_kEy_xxx
# UNKEY_API_ID=api_123456789
# UNKEY_BASE_URL=https://api.unkey.dev

# ------------------------------------------------------------------------------
# Multi-Project Static API Key Access (Built-in / Backward Compatibility)
# Comma-separated list of keys authorized to call the verification API.
# Projects should pass their key via `x-api-key: your-key` or `Authorization: Bearer your-key`
API_KEYS=mentalweg_key_2026,ecommerce_key_2026,client_portal_key_2026

# Backward-compatible single master key (matches MentalWeg VERIFIER_API_KEY)
VERIFIER_API_KEY=senaycreatives-verifier-secret-key-2026

# Rate Limiting (max requests per minute per IP / key)
RATE_LIMIT_PER_MINUTE=120

# Optional Proxy Keys (if using custom receipt fetch proxies)
FALLBACK_PROXIES=
SKIP_PRIMARY_VERIFICATION=false
