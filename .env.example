# ==============================================================================
# Senay Verifier API Configuration
# Microservice for: Telebirr, CBE, Dashen, BoA, CBE Birr, M-Pesa
# Deployment URL: https://verifier.senaycreatives.com
# ==============================================================================

PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Multi-Project API Key Access
# Comma-separated list of keys authorized to call the verification API.
# Projects should pass their key via `x-api-key: your-key` or `Authorization: Bearer your-key`
API_KEYS=mentalweg_key_2026,ecommerce_key_2026,client_portal_key_2026

# Backward-compatible single master key (matches MentalWeg VERIFIER_API_KEY)
VERIFIER_API_KEY=senaycreatives-verifier-secret-key-2026

# Rate Limiting (max requests per minute per IP / key)
RATE_LIMIT_PER_MINUTE=120

# Optional Proxy Keys (if using custom receipt fetch proxies)
FALLBACK_PROXIES=
SKIP_PRIMARY_VERIFICATION=false
